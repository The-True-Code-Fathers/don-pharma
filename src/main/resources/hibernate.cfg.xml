<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- JDBC Connection -->
        <property name="hibernate.connection.driver_class">org.postgresql.Driver</property>
        <property name="hibernate.connection.url">jdbc:postgresql://localhost:5432/dondb</property>
        <property name="hibernate.connection.username">admin</property>
        <property name="hibernate.connection.password">password</property>

        <!-- Dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.PostgreSQLDialect</property>

        <!-- Behavior -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">update</property> <!-- dev only -->

        <!-- Entity Mapping -->
        <mapping class="com.codefathers.model.entity.Employee"/>
        <mapping class="com.codefathers.model.entity.Product" />
        <mapping class="com.codefathers.model.entity.Order" />
        <mapping class="com.codefathers.model.entity.OrderItem" />
        <mapping class="com.codefathers.model.entity.ShippingProvider" />
        <mapping class="com.codefathers.model.entity.ShippingArea" />
        <mapping class="com.codefathers.model.entity.Storage"/>
        <mapping class="com.codefathers.model.entity.Payment" />
        <mapping class="com.codefathers.model.entity.ShippingOrder"/>
        <mapping class="com.codefathers.model.entity.SystemUser" />
    </session-factory>
</hibernate-configuration>